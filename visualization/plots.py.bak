"""
Plotly Interactive Visualization Engine for RF Signals
======================================================
Provides responsive, high-contrast, publication-grade interactive plots
for Streamlit and web dashboards:
- PSD Spectrum with Peak & Bandwidth overlay
- 2D Time-Frequency Waterfall Spectrogram
- In-Phase vs Quadrature Constellation Diagram
- Multi-trace Eye Diagram
- Time-Domain Envelope and Phase Traces
"""

from typing import Optional
import numpy as np
import plotly.graph_objects as go
from plotly.subplots import make_subplots


def plot_welch_psd(
    f: np.ndarray,
    psd_db: np.ndarray,
    fc_peak: Optional[float] = None,
    bw_3db: Optional[float] = None,
    f_lower_3db: Optional[float] = None,
    f_upper_3db: Optional[float] = None
) -> go.Figure:
    """
    Creates an interactive Power Spectral Density (PSD) line plot with
    center frequency and -3 dB bandwidth annotations.
    """
    fig = go.Figure()

    # Downsample if spectrum array is too dense
    if len(f) > 4096:
        step = len(f) // 4096
        f_plot = f[::step]
        psd_plot = psd_db[::step]
    else:
        f_plot = f
        psd_plot = psd_db

    # Convert Hz to kHz or MHz for clean axis display
    max_freq = np.max(np.abs(f)) if len(f) > 0 else 1.0
    if max_freq >= 1e6:
        scale = 1e6
        unit = "MHz"
    elif max_freq >= 1e3:
        scale = 1e3
        unit = "kHz"
    else:
        scale = 1.0
        unit = "Hz"

    fig.add_trace(go.Scatter(
        x=f_plot / scale,
        y=psd_plot,
        mode='lines',
        name='Welch PSD',
        line=dict(color='#00d2ff', width=1.8),
        hovertemplate=f"Freq: %{{x:.3f}} {unit}<br>Power: %{{y:.2f}} dB/Hz<extra></extra>"
    ))

    # Add Center Frequency vertical line
    if fc_peak is not None:
        fig.add_vline(
            x=fc_peak / scale,
            line_dash="dash",
            line_color="#ff4b4b",
            annotation_text=f"fc = {fc_peak / scale:.2f} {unit}",
            annotation_position="top left",
            annotation_font_color="#ff4b4b"
        )

    # Add -3 dB Bandwidth shaded region
    if f_lower_3db is not None and f_upper_3db is not None:
        fig.add_vrect(
            x0=f_lower_3db / scale,
            x1=f_upper_3db / scale,
            fillcolor="#00ff88",
            opacity=0.15,
            line_width=0,
            annotation_text=f"BW (-3dB) = {bw_3db / scale:.2f} {unit}" if bw_3db else "",
            annotation_position="bottom right",
            annotation_font_color="#00ff88"
        )

    fig.update_layout(
        title=dict(text="<b>Power Spectral Density (Welch Periodogram)</b>", font=dict(size=16)),
        xaxis=dict(title=f"Frequency ({unit})", showgrid=True, gridcolor="#2a2e39"),
        yaxis=dict(title="Power Spectral Density (dB/Hz)", showgrid=True, gridcolor="#2a2e39"),
        template="plotly_dark",
        margin=dict(l=40, r=40, t=50, b=40),
        hovermode="x unified",
        height=420
    )
    return fig


def plot_spectrogram_waterfall(
    t: np.ndarray,
    f: np.ndarray,
    sxx_db: np.ndarray
) -> go.Figure:
    """
    Creates an interactive 2D Waterfall / Spectrogram heatmap.
    """
    max_freq = np.max(np.abs(f)) if len(f) > 0 else 1.0
    if max_freq >= 1e6:
        scale = 1e6
        unit = "MHz"
    elif max_freq >= 1e3:
        scale = 1e3
        unit = "kHz"
    else:
        scale = 1.0
        unit = "Hz"

    fig = go.Figure(data=go.Heatmap(
        z=sxx_db,
        x=f / scale,
        y=t,
        colorscale="Viridis",
        colorbar=dict(title="Power (dB/Hz)"),
        hovertemplate=f"Freq: %{{x:.3f}} {unit}<br>Time: %{{y:.4f}} s<br>Power: %{{z:.1f}} dB<extra></extra>"
    ))

    fig.update_layout(
        title=dict(text="<b>Time-Frequency Spectrogram (Waterfall)</b>", font=dict(size=16)),
        xaxis=dict(title=f"Frequency ({unit})", showgrid=False),
        yaxis=dict(title="Time (seconds)", showgrid=False),
        template="plotly_dark",
        margin=dict(l=40, r=40, t=50, b=40),
        height=420
    )
    return fig


def plot_iq_constellation(
    signal: np.ndarray,
    max_points: int = 3000
) -> go.Figure:
    """
    Creates a scatter plot of In-Phase (I) vs Quadrature (Q) complex baseband samples.
    """
    if len(signal) > max_points:
        step = len(signal) // max_points
        sig_sample = signal[::step]
    else:
        sig_sample = signal

    i_vals = np.real(sig_sample)
    q_vals = np.imag(sig_sample)
    mag_vals = np.abs(sig_sample)

    fig = go.Figure()

    # Scatter points
    fig.add_trace(go.Scatter(
        x=i_vals,
        y=q_vals,
        mode='markers',
        marker=dict(
            size=4.5,
            color=mag_vals,
            colorscale='Electric',
            opacity=0.75,
            showscale=False
        ),
        name='IQ Samples',
        hovertemplate="I: %{x:.3f}<br>Q: %{y:.3f}<extra></extra>"
    ))

    # Add reference unit circle
    theta = np.linspace(0, 2 * np.pi, 200)
    fig.add_trace(go.Scatter(
        x=np.cos(theta),
        y=np.sin(theta),
        mode='lines',
        line=dict(color='rgba(255, 255, 255, 0.25)', dash='dot', width=1.2),
        name='Unit Circle',
        hoverinfo='skip'
    ))

    # Limit axes symmetrically
    max_lim = max(1.5, float(np.percentile(np.abs(sig_sample), 99) * 1.3))

    fig.update_layout(
        title=dict(text="<b>I/Q Constellation Diagram</b>", font=dict(size=16)),
        xaxis=dict(
            title="In-Phase (I)",
            range=[-max_lim, max_lim],
            scaleanchor="y",
            scaleratio=1,
            showgrid=True,
            gridcolor="#2a2e39"
        ),
        yaxis=dict(
            title="Quadrature (Q)",
            range=[-max_lim, max_lim],
            showgrid=True,
            gridcolor="#2a2e39"
        ),
        template="plotly_dark",
        margin=dict(l=40, r=40, t=50, b=40),
        height=450,
        showlegend=False
    )
    return fig


def plot_eye_diagram(
    signal: np.ndarray,
    samples_per_symbol: int = 16,
    num_traces: int = 60
) -> go.Figure:
    """
    Creates an Eye Diagram across 2 symbol periods for timing jitter and ISI analysis.
    """
    trace_len = 2 * samples_per_symbol
    total_traces_available = len(signal) // samples_per_symbol - 2

    if total_traces_available <= 0:
        return go.Figure()

    traces_to_plot = min(num_traces, total_traces_available)
    step = max(1, total_traces_available // traces_to_plot)

    time_axis = np.linspace(-1.0, 1.0, trace_len)

    fig = make_subplots(
        rows=1, cols=2,
        subplot_titles=("<b>In-Phase (I) Eye</b>", "<b>Quadrature (Q) Eye</b>")
    )

    for i in range(0, traces_to_plot * step, step):
        idx = i * samples_per_symbol
        if idx + trace_len <= len(signal):
            chunk = signal[idx : idx + trace_len]
            # In-Phase trace
            fig.add_trace(
                go.Scatter(
                    x=time_axis,
                    y=np.real(chunk),
                    mode='lines',
                    line=dict(color='rgba(0, 210, 255, 0.35)', width=1.2),
                    showlegend=False,
                    hoverinfo='skip'
                ),
                row=1, col=1
            )
            # Quadrature trace
            fig.add_trace(
                go.Scatter(
                    x=time_axis,
                    y=np.imag(chunk),
                    mode='lines',
                    line=dict(color='rgba(255, 75, 75, 0.35)', width=1.2),
                    showlegend=False,
                    hoverinfo='skip'
                ),
                row=1, col=2
            )

    fig.update_layout(
        template="plotly_dark",
        margin=dict(l=40, r=40, t=50, b=40),
        height=380
    )
    fig.update_xaxes(title_text="Symbol Period (T_sym)", showgrid=True, gridcolor="#2a2e39")
    fig.update_yaxes(title_text="Amplitude", showgrid=True, gridcolor="#2a2e39")
    return fig


def plot_time_domain_envelope(
    signal: np.ndarray,
    fs: float,
    max_points: int = 1500
) -> go.Figure:
    """
    Plots real, imaginary, and envelope magnitude time series.
    """
    if len(signal) > max_points:
        step = len(signal) // max_points
        sig_sample = signal[: max_points * step : step]
    else:
        sig_sample = signal

    t = np.arange(len(sig_sample)) / (fs / (len(signal) / len(sig_sample)))
    # Convert time to ms or us if short
    if np.max(t) < 1e-3:
        t_scale = 1e6
        t_unit = "μs"
    elif np.max(t) < 1.0:
        t_scale = 1e3
        t_unit = "ms"
    else:
        t_scale = 1.0
        t_unit = "s"

    fig = go.Figure()

    fig.add_trace(go.Scatter(
        x=t * t_scale,
        y=np.real(sig_sample),
        mode='lines',
        name='In-Phase (I)',
        line=dict(color='#00d2ff', width=1.4)
    ))

    fig.add_trace(go.Scatter(
        x=t * t_scale,
        y=np.imag(sig_sample),
        mode='lines',
        name='Quadrature (Q)',
        line=dict(color='#ff4b4b', width=1.4)
    ))

    fig.add_trace(go.Scatter(
        x=t * t_scale,
        y=np.abs(sig_sample),
        mode='lines',
        name='Magnitude |y|',
        line=dict(color='#00ff88', width=2.0, dash='dash')
    ))

    fig.update_layout(
        title=dict(text="<b>Time-Domain Envelope & Baseband Traces</b>", font=dict(size=16)),
        xaxis=dict(title=f"Time ({t_unit})", showgrid=True, gridcolor="#2a2e39"),
        yaxis=dict(title="Amplitude", showgrid=True, gridcolor="#2a2e39"),
        template="plotly_dark",
        margin=dict(l=40, r=40, t=50, b=40),
        hovermode="x unified",
        height=380
    )
    return fig
